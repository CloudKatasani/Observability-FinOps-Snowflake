# API service image. Build context: repository root.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
COPY packages/common/pyproject.toml packages/common/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
RUN uv sync --frozen --no-install-workspace --no-dev

COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/worker/ apps/worker/
RUN uv sync --frozen --no-dev --package snowobs-api

FROM python:3.12-slim-bookworm
RUN groupadd --system snowobs && useradd --system --gid snowobs --no-create-home snowobs
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps/api /app/apps/api
COPY config/ /app/config/
ENV PATH="/app/.venv/bin:$PATH" SNOWOBS_BRANDING_FILE=/app/config/branding.yaml
USER snowobs
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status == 200 else 1)"]
CMD ["uvicorn", "snowobs_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
