# Worker service image. Build context: repository root.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
COPY packages/common/pyproject.toml packages/common/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
RUN uv sync --frozen --no-install-workspace --no-dev

COPY packages/ packages/
COPY apps/worker/ apps/worker/
COPY apps/api/ apps/api/
RUN uv sync --frozen --no-dev --package snowobs-worker

FROM python:3.12-slim-bookworm
RUN groupadd --system snowobs && useradd --system --gid snowobs --no-create-home snowobs
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/packages /app/packages
COPY --from=builder /app/apps/worker /app/apps/worker
# The alert evaluation job runs the API's AlertService, so the workspace
# package must be present in the runtime image, not only at build time.
COPY --from=builder /app/apps/api /app/apps/api
COPY config/ /app/config/
ENV PATH="/app/.venv/bin:$PATH" SNOWOBS_BRANDING_FILE=/app/config/branding.yaml \
    ALERTING__RULES_FILE=/app/config/alert_rules.yaml
USER snowobs
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD ["arq", "--check", "snowobs_worker.main.WorkerSettings"]
CMD ["arq", "snowobs_worker.main.WorkerSettings"]
