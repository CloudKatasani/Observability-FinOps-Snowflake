# terraform init -backend-config=backend.hcl
#
# Remote state, so two people cannot apply at once and so a lost laptop does not
# lose the deployment. Create the bucket and the lock table once, out of band:
#
#   aws s3api create-bucket --bucket acme-snowobs-tfstate --region eu-west-1 \
#     --create-bucket-configuration LocationConstraint=eu-west-1
#   aws s3api put-bucket-versioning --bucket acme-snowobs-tfstate \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name acme-snowobs-tflock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST
#
# The state file holds resource ids and endpoints, never secret values (§27.13),
# but it still describes the deployment in full: keep the bucket private,
# versioned, and encrypted, and restrict who can read it.

bucket         = "acme-snowobs-tfstate"
key            = "prod/terraform.tfstate"
region         = "eu-west-1"
dynamodb_table = "acme-snowobs-tflock"
encrypt        = true
kms_key_id     = "alias/aws/s3"
