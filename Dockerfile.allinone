# All-in-one production image: API + arq worker + the built SPA behind one port.
#
# Build context: the repository root.
#   docker build -f Dockerfile.allinone -t snowobs:demo .
#   docker run --rm -p 8080:8080 -v snowobs-data:/app/.data snowobs:demo api
#
# Why one image: the three-service topology (deploy/docker/Dockerfile.{api,worker,web})
# is the shape ECS runs, but a client laptop with locked-down Docker, an
# air-gapped assessment, or a single-node install wants one artefact. Both
# shapes run the *same* code and differ only in who serves the static bundle
# and who supervises the processes — R10: configuration and adapters, never a
# branch in application code.
#
# No secret is baked in. Everything the runtime needs arrives as environment
# variables or a mounted secret at run time; the image is safe to push to a
# registry that more people can read than can read the deployment.

# ─────────────────────────────────────────────────────────── stage 1: the SPA
FROM node:22-bookworm-slim AS web
WORKDIR /web
# package*.json first so a dependency-free source change reuses the install layer.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

# ────────────────────────────────────────────── stage 2: the Python workspace
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS python
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

# Manifests first: dependency resolution is the slow half and changes rarely.
COPY pyproject.toml uv.lock ./
COPY packages/agents/pyproject.toml packages/agents/pyproject.toml
COPY packages/analytics/pyproject.toml packages/analytics/pyproject.toml
COPY packages/common/pyproject.toml packages/common/pyproject.toml
COPY packages/dataproducts/pyproject.toml packages/dataproducts/pyproject.toml
COPY packages/engines/pyproject.toml packages/engines/pyproject.toml
COPY packages/finops/pyproject.toml packages/finops/pyproject.toml
COPY packages/ingest/pyproject.toml packages/ingest/pyproject.toml
COPY packages/llm/pyproject.toml packages/llm/pyproject.toml
COPY packages/semantics/pyproject.toml packages/semantics/pyproject.toml
COPY packages/snowflake_live/pyproject.toml packages/snowflake_live/pyproject.toml
COPY packages/sqlguard/pyproject.toml packages/sqlguard/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY fixtures/generator/pyproject.toml fixtures/generator/pyproject.toml
RUN uv sync --frozen --no-dev --no-install-workspace --all-extras

COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/worker/ apps/worker/
COPY fixtures/generator/ fixtures/generator/
# --all-packages: the API, the worker, and the fixture generator all live in
# this one image, because it is also the image that seeds the demo dataset.
# --all-extras: the LLM adapters are the only optional dependencies in the
# workspace, and an image that cannot import `anthropic` or `boto3` can only
# run the `cortex` and `none` providers — which would make R11's portability
# a property of the source tree rather than of anything shipped.
RUN uv sync --frozen --no-dev --all-packages --all-extras

# ─────────────────────────────────────────────────────────── stage 3: runtime
FROM python:3.12-slim-bookworm AS runtime

# tini reaps the children the entrypoint spawns; without a real PID 1 a killed
# uvicorn worker becomes a zombie and the container's memory grows quietly.
RUN apt-get update \
 && apt-get install --no-install-recommends -y tini \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system snowobs && useradd --system --gid snowobs --no-create-home snowobs
WORKDIR /app

COPY --from=python /app/.venv /app/.venv
COPY --from=python /app/packages /app/packages
COPY --from=python /app/apps/api /app/apps/api
COPY --from=python /app/apps/worker /app/apps/worker
COPY --from=python /app/fixtures/generator /app/fixtures/generator
COPY --from=web /web/dist /app/web
COPY deploy/docker/allinone/asgi.py /app/allinone/asgi.py
COPY deploy/docker/allinone/entrypoint.sh /usr/local/bin/snowobs-allinone
COPY scripts/demo_seed.py /app/scripts/demo_seed.py
COPY config/ /app/config/

# /app/.data is the OFFLINE lake (DatasetService.storage_root). It is the only
# path the container writes to, so the root filesystem can be mounted read-only
# with just this one volume writable.
RUN mkdir -p /app/.data \
 && chown -R snowobs:snowobs /app/.data \
 && chmod 0755 /usr/local/bin/snowobs-allinone

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    SNOWOBS_BRANDING_FILE=/app/config/branding.yaml \
    SNOWOBS_MODE=offline
VOLUME ["/app/.data"]

USER snowobs
EXPOSE 8080

# Liveness only: /healthz never touches Postgres or Redis, so a container whose
# database is briefly unreachable is not killed for it. Readiness (/readyz) is
# the load balancer's business, not the supervisor's.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status == 200 else 1)"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/snowobs-allinone"]
CMD ["api", "worker"]
