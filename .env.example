# ── snowobs configuration (BUILD_PROMPT §21) ─────────────────────────────────
# Copy to .env for local development. Every value has a safe default for the
# local compose stack; production deployments set these via their secret/config
# mechanism. Settings are validated at startup — a bad value fails fast with a
# readable error. No secrets belong in this file beyond local dev credentials.

# Operating mode: live (Snowflake connection), offline (uploads), auto (detect).
SNOWOBS_MODE=auto
# single-tenant (one org) or multi-tenant (assessor/consultancy hosting).
SNOWOBS_TENANCY=single
# JSON logs (true) or human-readable console logs (false, dev only).
SNOWOBS_LOG_JSON=false
# White-label branding file (display name, palette).
SNOWOBS_BRANDING_FILE=config/branding.yaml

# ── App metadata store (Postgres) — telemetry never lives here (R2) ──────────
DATABASE_URL=postgresql+asyncpg://snowobs:snowobs@localhost:5432/snowobs

# ── Queue / cache (Redis) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (uploads, parquet, exports, caches) ───────────────────────
# provider: s3 | minio | local
STORAGE__PROVIDER=minio
STORAGE__BUCKET=snowobs
# Endpoint only for minio/local-S3-compatible stores; omit for AWS S3.
STORAGE__ENDPOINT_URL=http://localhost:9000
#STORAGE__REGION=eu-west-1

# ── Secrets adapter — only secret *references* are stored in the DB ──────────
# provider: aws (Secrets Manager) | file (local encrypted) | env (dev)
SECRETS__PROVIDER=env

# ── Authentication ───────────────────────────────────────────────────────────
# provider: oidc | local (dev fallback; not available in production builds)
AUTH__PROVIDER=local
#AUTH__ISSUER=https://login.example.com/tenant-id/v2.0
#AUTH__CLIENT_ID=snowobs

# ── LLM adapter (R11). "none" = deterministic template mode, no API key ──────
# provider: anthropic | bedrock | cortex | none
LLM__PROVIDER=none
#LLM__MODEL_STRONG=claude-opus-5
#LLM__MODEL_FAST=claude-haiku-4-5
LLM__DAILY_USD_CAP=25

# ── Snowflake connection (LIVE mode) ─────────────────────────────────────────
#SNOWFLAKE__ACCOUNT=myorg-myaccount
#SNOWFLAKE__USER=SNOWOBS_SVC
# auth: keypair (recommended) | oauth | pat | externalbrowser (local dev only)
SNOWFLAKE__AUTH=keypair
# Reference resolved by the secrets adapter — never the key material itself.
#SNOWFLAKE__PRIVATE_KEY_REF=snowobs/snowflake/private-key
#SNOWFLAKE__ROLE=SNOWOBS_READER
#SNOWFLAKE__WAREHOUSE=WH_SNOWOBS_APP
SNOWFLAKE__QUERY_TAG_PREFIX=SNOWOBS
SNOWFLAKE__STATEMENT_TIMEOUT_S=300

# ── FinOps behaviour ─────────────────────────────────────────────────────────
# Fallback credit price when RATE_SHEET_DAILY is unavailable (renders "estimated").
#FINOPS__CREDIT_PRICE_USD=3.00
# Reconciliation gate tolerance, percent (R6).
FINOPS__RECONCILE_TOLERANCE_PCT=0.5
# showback (default for the first months) | chargeback
FINOPS__MODE=showback
# Business day of month for the close (BD3 default).
FINOPS__CLOSE_BUSINESS_DAY=3

# ── Query guardrails (R9) ────────────────────────────────────────────────────
GUARDRAILS__MAX_ROWS=50000
GUARDRAILS__ALLOW_ADHOC_SQL=false
